{
  "entities": {
    "Receipt": {
      "title": "Receipt",
      "description": "Scanned expense or income record with OCR metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "transactionType": { "type": "string", "enum": ["income", "expense"] },
        "supplier": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "totalTTC": { "type": "number" },
        "vatRate": { "type": "number" },
        "vatAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string", "enum": ["validé", "en_attente"] },
        "fileName": { "type": "string" },
        "imageUrl": { "type": "string" },
        "storagePath": { "type": "string" },
        "currency": { "type": "string" },
        "originalTotal": { "type": "number" },
        "exchangeRate": { "type": "number" },
        "aiExtracted": { "type": "boolean" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "supplier", "date", "totalTTC", "status", "transactionType"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User specific settings and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "estimatedTaxRate": { "type": "number" },
        "nextInvoiceNumber": { "type": "number" },
        "telegramId": { "type": "string", "description": "Telegram Chat ID" },
        "telegramToken": { "type": "string", "description": "Temporary token for linking" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "estimatedTaxRate"]
    },
    "Invoice": {
      "title": "Issued Invoice",
      "description": "Invoice issued to a client",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "clientName": { "type": "string" },
        "date": { "type": "string" },
        "dueDate": { "type": "string" },
        "totalHT": { "type": "number" },
        "totalTTC": { "type": "number" },
        "vatAmount": { "type": "number" },
        "vatRate": { "type": "number" },
        "status": { "type": "string", "enum": ["payé", "en_attente", "annulé"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "invoiceNumber", "clientName", "date", "totalTTC", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User specific settings"
    },
    "/users/{userId}/receipts/{receiptId}": {
      "schema": "Receipt",
      "description": "User specific receipt documents"
    },
    "/users/{userId}/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "User issued invoices"
    }
  }
}
